rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions to check user roles based on a 'users' collection.
    // In this model, we have a top-level 'users' collection where each user's
    // role and churchId is stored.
    function isUserInChurch(churchId) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == churchId;
    }

    function isAdmin(churchId) {
      return isUserInChurch(churchId) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isLeader(churchId) {
      let userRole = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return isUserInChurch(churchId) && (userRole == 'admin' || userRole == 'leader');
    }

    // Matches any document in the 'churches' collection.
    match /churches/{churchId} {

      // All users must be authenticated and part of the church to read/write anything.
      allow read, write: if request.auth != null && isUserInChurch(churchId);

      // --- Collections with Admin-only write access ---
      match /members/{memberId} {
        allow read: if isLeader(churchId);
        allow create, update, delete: if isAdmin(churchId);
      }

      match /donations/{donationId} {
        allow read, create, update, delete: if isAdmin(churchId);
      }

      match /automations/{automationId} {
	allow read, create, update, delete: if isAdmin(churchId);
      }

      // --- Collections with Leader access ---
      match /attendance/{attendanceId} {
        allow read, create: if isLeader(churchId);
        allow update, delete: if isAdmin(churchId);
      }

      match /members/{memberId}/communicationLog/{logId} {
	allow read, create: if isLeader(churchId);
        allow update, delete: if isAdmin(churchId);
      }

      // --- Collections accessible by all church members ---
      match /devotions/{devotionId} {
        allow read: if isUserInChurch(churchId);
        allow create, update, delete: if isLeader(churchId);
      }

      match /sermons/{sermonId} {
        allow read: if isUserInChurch(churchId);
        allow create, update, delete: if isLeader(churchId);
      }

      // --- Group data ---
      match /groups/{groupId} {
        // Any member of the church can see the list of groups
        allow read: if isUserInChurch(churchId);
        // Only leaders/admins can create or modify group details
        allow create, update, delete: if isLeader(churchId);

        // Group messages
        match /messages/{messageId} {
          // Only members of the group can read or write messages.
          // this.resource refers to the parent group document.
          allow read, create: if request.auth.uid in resource.data.members;
          allow update, delete: if isAdmin(churchId); // Or maybe group owner
        }
      }

      // Church config can be read by any member, but only changed by an admin.
      match /config/main {
        allow read: if isUserInChurch(churchId);
        allow write: if isAdmin(churchId);
      }
    }

    // The 'users' collection contains role information.
    // Users should be able to read their own data.
    // Only admins of a church should be able to change roles (this rule is simplified).
    match /users/{userId} {
	allow read: if request.auth.uid == userId;
      // In a real app, you'd want a more robust Cloud Function to handle role changes.
      allow write: if false;
    }
  }
}
